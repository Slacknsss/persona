    {
      "parameters": {
        "jsCode": "const raw = String($input.first().json.chatInput || '').trim().toLowerCase();\nconst m = raw.match(/^(\\d{1,2})\\s*(?:h|:)?\\s*(\\d{1,2})?$/);\nlet ok = false, hhmm = '';\nif (m) {\n  const h = parseInt(m[1], 10);\n  const min = m[2] === undefined ? 0 : parseInt(m[2], 10);\n  if (h >= 0 && h < 24 && min >= 0 && min < 60) {\n    ok = true;\n    hhmm = String(h).padStart(2, '0') + ':' + String(min).padStart(2, '0');\n  }\n}\nreturn [{ json: { ok, hhmm } }];"
      },
